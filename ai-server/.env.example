# ── Nexus AI Server — environment ─────────────────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env.

# Shared secret the WordPress plugin sends as `Authorization: Bearer <key>`.
# Generate a strong one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string

# --- Chat provider (embeddings always use Ollama below) --------------------
# These are the FALLBACK. The WordPress plugin can override provider + model +
# key per request (Settings → AI Chatbot → Model & Provider); it sends only the
# provider *name*, and this server resolves the API endpoint itself. Leave the
# key blank in WordPress to use the credentials configured here instead.
#
# 'ollama' (default), 'anthropic', or 'openai' for any OpenAI-compatible API:
#   OpenAI    → base https://api.openai.com/v1,        model gpt-4o-mini
#   Groq      → base https://api.groq.com/openai/v1,   model llama-3.3-70b-versatile
#   DeepSeek  → base https://api.deepseek.com/v1,      model deepseek-chat
#   Mistral   → base https://api.mistral.ai/v1,        model mistral-small-latest
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic — the only provider that does vision + tool calling in one request,
# and the only one with explicit prompt caching. Needs `pip install anthropic`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# 'adaptive' (Claude decides when to think) or 'off'. Ignored on older models.
ANTHROPIC_THINKING=adaptive
# low|medium|high|xhigh|max, or 'off'. 'low' keeps a chat widget snappy.
ANTHROPIC_EFFORT=low

# Cap on generated tokens per turn (adaptive thinking also draws from this).
LLM_MAX_TOKENS=4096
# Mark the stable prompt prefix (tools + system + few-shot) cacheable. Anthropic
# only; OpenAI-compatible providers cache automatically.
PROMPT_CACHE=true

# --- Capability detection (reported on /health, consumed by the plugin) -----
# auto = probe the model name; on/off = force. The plugin falls back to its
# legacy single-shot path whenever tool calling is unavailable.
LLM_TOOLS=auto
LLM_VISION=auto
# Substrings of tool-capable model ids, per provider family.
# TOOL_CAPABLE_OPENAI=gpt-4,gpt-5,llama-3.3,qwen,deepseek
# TOOL_CAPABLE_OLLAMA=qwen3,llama3.1
# VISION_CAPABLE_OPENAI=gpt-4o,gpt-4.1,gpt-5

# Ollama server (running on the same VPS by default). Embeddings + vision always here.
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.1:8b
# Vision model — used automatically when a visitor attaches an image/screenshot.
VISION_MODEL=llava
OLLAMA_TIMEOUT=120

# Where ChromaDB persists its vectors (the chatbot "memory").
CHROMA_DIR=/var/lib/nexus-ai/chroma

# RAG tuning
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_CHUNKS_PER_REQUEST=5000

# Optional: comma-separated CORS origins. Leave empty — the WP plugin proxies
# requests server-side, so the browser never calls this service directly.
CORS_ORIGINS=
