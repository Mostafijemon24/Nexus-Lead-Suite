[Unit]
Description=Nexus AI Server (RAG backend for Nexus Lead Suite)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=nexusai
Group=nexusai
WorkingDirectory=/opt/nexus-ai/ai-server
EnvironmentFile=/opt/nexus-ai/ai-server/.env
ExecStart=/opt/nexus-ai/ai-server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
# Let it persist vectors + create runtime dirs
StateDirectory=nexus-ai

[Install]
WantedBy=multi-user.target
