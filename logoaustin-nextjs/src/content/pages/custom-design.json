           "classes": []
          },
          {
           "t": "text",
           "html": "<div><table><thead><tr><th scope=\"col\">Format</th><th scope=\"col\">Use It For</th></tr></thead><tbody><tr><td><strong>AI / EPS</strong></td><td>Editable vector source files for printers, sign makers and future edits</td></tr><tr><td><strong>SVG</strong></td><td>Websites and apps; scales without losing quality</td></tr><tr><td><strong>PDF</strong></td><td>Sending print-ready artwork</td></tr><tr><td><strong>PNG (transparent)</strong></td><td>Websites, social media and placing the logo over photos</td></tr><tr><td><strong>JPG</strong></td><td>Email, documents and quick sharing</td></tr></tbody></table></div>",
